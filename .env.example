# Base URL of the PromptIQ FastAPI backend (public, non-secret).
VITE_API_BASE_URL=http://localhost:8000

# Groq Cloud API Key for ultra-fast PromptCowboy prompt synthesis (Llama 3.3 70B @ ~800 tokens/sec)
# Get a free API key at: https://console.groq.com/keys
# Supported both in browser (VITE_GROQ_API_KEY) and server-side (GROQ_API_KEY)
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_API_KEY=gsk_your_groq_api_key_here
